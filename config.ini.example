; Скопируйте этот файл в "config.ini" при необходимости изменить настройки
[mysql]
host = localhost
port = 3306
user = root
password = ВАШ_ПАРОЛЬ_ОТ_MYSQL
database = lumiere_salon

[app]
port = 5000
secret_key = lumiere_secret_key_123
; db_driver: "auto" (пробует подключиться к MySQL, при недоступности переключается на SQLite),
; либо принудительно "mysql" или "sqlite"
db_driver = auto
sqlite_path = lumiere.db
